rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Check if the user has a valid school or partner domain
    function isValidDomain() {
      return request.auth.token.email.matches('.*@edu\\.lappeenranta\\.fi$') 
          || request.auth.token.email.matches('.*@lappee\\.fi$');
    }

    // 2. Verify it is a valid school Google/Microsoft account
    function isSchoolUser() {
      return request.auth != null
        && (request.auth.token.firebase.sign_in_provider == 'google.com' || request.auth.token.firebase.sign_in_provider == 'microsoft.com')
        && request.auth.token.email_verified == true
        && isValidDomain();
    }

    // 3. Global Admins (Pasi and Joni)
    function isGlobalAdmin() {
      return request.auth.token.email == 'pasi.hulkkonen@edu.lappeenranta.fi' 
          || request.auth.token.email == 'joni.hikipaa@edu.lappeenranta.fi';
    }

    // 4. Look up 'Admin' status safely (hardcoded + DB check)
    function isAdmin() {
      let roleDoc = /databases/$(database)/documents/user_roles/$(request.auth.uid);
      return (exists(roleDoc) && get(roleDoc).data.role == 'admin') 
          || request.auth.token.email == 'asentaja@lappee.fi';
    }

    function getAdminCostCenter() {
      let roleDoc = /databases/$(database)/documents/user_roles/$(request.auth.uid);
      return exists(roleDoc) ? get(roleDoc).data.CostCenter : null;
    }

    // ---------------------------------------------------
    // PERMISSIONS
    // ---------------------------------------------------

    // The 'user_roles' collection (Users only read their own)
    match /user_roles/{userId} {
      allow read: if isSchoolUser() && (request.auth.uid == userId || isGlobalAdmin());
      allow write: if isSchoolUser() && isGlobalAdmin();
    }

    // PII Data (Only Global Admins & Admins can read/write)
    match /device_pii/{serial} {
      allow read, write: if isSchoolUser() && isGlobalAdmin();
      // Digari Admin voi lukea ja kirjoittaa PII-tietoja, JOS vastaava laite kuuluu heidän kustannuspaikkaansa.
      allow read, write: if isSchoolUser() && isAdmin() && get(/databases/$(database)/documents/devices/$(serial)).data.CostCenter == getAdminCostCenter();
    }

    // Public Device Data
    match /devices/{serial} {
      // Read: Global admin näkee kaiken. Digari admin näkee vain oman kustannuspaikkansa laitteet.
      allow read: if isSchoolUser() && (isGlobalAdmin() || (isAdmin() && resource.data.CostCenter == getAdminCostCenter()) || request.auth.token.email == 'asentaja@lappee.fi');
      
      // Update/Create: Global Admin voi tehdä mitä vain.
      // Digari Admin voi päivittää vain oman kustannuspaikkansa laitteita ja luoda uusia omaan kustannuspaikkaansa.
      allow create: if isSchoolUser() && (isGlobalAdmin() || (isAdmin() && request.resource.data.CostCenter == getAdminCostCenter() && request.resource.data.Status != "Poistettu"));
      allow update: if isSchoolUser() && (
        isGlobalAdmin() || 
        (isAdmin() && resource.data.CostCenter == getAdminCostCenter() && request.resource.data.CostCenter == getAdminCostCenter())
      );
      
      // Salli "Hard Delete" ainoastaan Global Admineille (muille vain "Poistettu" tila, mikä hoidetaan update-säännössä, josta ei ole rajoitettu "Status"-kenttää).
      allow delete: if isSchoolUser() && isGlobalAdmin();
    }
    
    // All other collections are denied by default since the global wildcard was removed.
  }
}
