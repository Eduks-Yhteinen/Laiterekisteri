        {
          "AFDDataSourceName": "",
          "AutoRuleBindingEnabled": false,
          "AutoRuleBindingString": "// 1. Tyhjennetään lomake\r\nReset(TextInput_Lainaaja);\r\nReset(TextInput_Yksikko);\r\nSet(varMessage, \"\"); \r\n\r\n// 2. Haku: Käytetään First(...).Value modernille lukijalle\r\nSet(varScannedDevice, \r\n    LookUp(Lainalaitteet, Sarjanumero = First(BarcodeReader1.Barcodes).Value)\r\n); \r\n\r\n// 3. Logiikka\r\nIf(IsBlank(varScannedDevice),\r\n    Notify(\"Virhe: Laitetta ei löydy rekisteristä!\", NotificationType.Error),\r\n\r\n    // Tarkistetaan Tila (Varmista että sarake on Choice/Valinta)\r\n    If(varScannedDevice.Tila.Value = \"Lainassa\",\r\n        \r\n        // --- PALAUTUS-TILA ---\r\n        Set(varMode, \"Palautus\");\r\n        // Haetaan avoin lainaus lokista. \r\n        // HUOM: Käytän tässä 'Title' viittaamaan Laitteen Nimeen.\r\n        Set(varLastLoan, \r\n            LookUp(Lainausloki, Title = varScannedDevice.Title && IsBlank(PalautusPvm))\r\n        ),\r\n        \r\n        // --- LAINAUS-TILA ---\r\n        Set(varMode, \"Lainaus\")\r\n    )\r\n);",
